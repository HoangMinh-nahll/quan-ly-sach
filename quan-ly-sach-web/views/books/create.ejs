<%- include('../partials/header') %>
<div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-md p-8">
  <div class="flex items-center gap-3 mb-6">
    <a href="/books" class="text-gray-400 hover:text-gray-600">← Quay lại</a>
    <h2 class="text-2xl font-bold text-blue-900">➕ Thêm sách mới</h2>
  </div>
  <% if (error) { %><div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-5 text-sm">⚠️ <%= error %></div><% } %>
  <form method="POST" action="/books/create">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div class="md:col-span-2">
        <label class="block text-gray-700 font-medium mb-2">Tên sách <span class="text-red-500">*</span></label>
        <input type="text" name="ten_sach" required placeholder="Nhập tên sách"
          class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-400 focus:outline-none transition">
      </div>
      <div>
        <label class="block text-gray-700 font-medium mb-2">Tác giả <span class="text-red-500">*</span></label>
        <input type="text" name="tac_gia" required placeholder="Tên tác giả"
          class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-400 focus:outline-none transition">
      </div>
      <div>
        <label class="block text-gray-700 font-medium mb-2">Thể loại</label>
        <input type="text" name="the_loai" placeholder="VD: Công nghệ, Văn học..."
          class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-400 focus:outline-none transition">
      </div>
      <div>
        <label class="block text-gray-700 font-medium mb-2">Năm xuất bản</label>
        <input type="number" name="nam_xb" min="1900" max="2030" placeholder="VD: 2023"
          class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-400 focus:outline-none transition">
      </div>
      <div>
        <label class="block text-gray-700 font-medium mb-2">Số lượng <span class="text-red-500">*</span></label>
        <input type="number" name="so_luong" required min="1" value="1"
          class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-400 focus:outline-none transition">
      </div>
      <div class="md:col-span-2">
        <label class="block text-gray-700 font-medium mb-2">Mô tả</label>
        <textarea name="mo_ta" rows="3" placeholder="Mô tả ngắn về nội dung sách..."
          class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-400 focus:outline-none transition resize-none"></textarea>
      </div>
    </div>
    <div class="flex gap-3 mt-6">
      <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold px-8 py-3 rounded-lg transition">✅ Thêm sách</button>
      <a href="/books" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold px-8 py-3 rounded-lg transition">Hủy</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>