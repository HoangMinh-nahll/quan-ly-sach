<%- include('../partials/header') %>
<div class="bg-white rounded-2xl shadow-md p-6">
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-6">
    <h2 class="text-2xl font-bold text-blue-900">📖 Danh sách sách</h2>
    <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
      <form method="GET" action="/books" class="flex gap-2">
        <input type="text" name="search" value="<%= search %>" placeholder="Tìm tên sách, tác giả..."
          class="border border-gray-300 rounded-lg px-4 py-2 w-60 focus:ring-2 focus:ring-blue-400 focus:outline-none text-sm">
        <button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition">🔍 Tìm</button>
        <% if (search) { %><a href="/books" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm transition">✕</a><% } %>
      </form>
      <a href="/books/create" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition whitespace-nowrap">➕ Thêm sách</a>
    </div>
  </div>

  <% if (books.length === 0) { %>
    <div class="text-center py-16 text-gray-400"><div class="text-6xl mb-4">📭</div><p>Không tìm thấy sách nào</p></div>
  <% } else { %>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead><tr class="bg-blue-50 text-blue-900">
        <th class="px-4 py-3 text-left">STT</th>
        <th class="px-4 py-3 text-left">Tên sách</th>
        <th class="px-4 py-3 text-left">Tác giả</th>
        <th class="px-4 py-3 text-left">Thể loại</th>
        <th class="px-4 py-3 text-center">Năm XB</th>
        <th class="px-4 py-3 text-center">Tổng</th>
        <th class="px-4 py-3 text-center">Còn lại</th>
        <th class="px-4 py-3 text-center">Thao tác</th>
      </tr></thead>
      <tbody>
        <% books.forEach((book, i) => { %>
        <tr class="border-t border-gray-100 hover:bg-gray-50 transition">
          <td class="px-4 py-3 text-gray-500"><%= i + 1 %></td>
          <td class="px-4 py-3 font-medium"><%= book.ten_sach %></td>
          <td class="px-4 py-3 text-gray-600"><%= book.tac_gia %></td>
          <td class="px-4 py-3"><span class="bg-blue-100 text-blue-700 px-2 py-1 rounded-full text-xs"><%= book.the_loai || '—' %></span></td>
          <td class="px-4 py-3 text-center text-gray-500"><%= book.nam_xb || '—' %></td>
          <td class="px-4 py-3 text-center font-medium"><%= book.so_luong %></td>
          <td class="px-4 py-3 text-center">
            <span class="px-3 py-1 rounded-full text-xs font-bold <%= book.so_luong_con > 0 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>"><%= book.so_luong_con %></span>
          </td>
          <td class="px-4 py-3">
            <div class="flex gap-2 justify-center">
              <a href="/books/<%= book.id %>/edit" class="bg-yellow-400 hover:bg-yellow-500 text-white px-3 py-1 rounded-lg text-xs font-medium transition">✏️ Sửa</a>
              <form method="POST" action="/books/<%= book.id %>/delete" onsubmit="return confirm('Xóa sách: <%= book.ten_sach %>?')">
                <button class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-lg text-xs font-medium transition">🗑️ Xóa</button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="text-gray-400 text-xs mt-3 text-right">Tổng: <%= books.length %> sách</p>
  <% } %>
</div>
<%- include('../partials/footer') %>