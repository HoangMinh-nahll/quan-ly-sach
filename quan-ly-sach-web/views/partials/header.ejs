<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>📚 Quản Lý Sách - Nhóm 5</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans flex flex-col min-h-screen">

<header class="bg-blue-900 text-white shadow-lg">
  <div class="container mx-auto px-4 py-4 flex flex-col md:flex-row items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold">📚 Hệ thống Quản Lý Sách</h1>
      <p class="text-blue-300 text-sm">Trường ĐH Đông Á - Khoa CNTT | Nhóm 5</p>
    </div>
    <% if (user) { %>
    <div class="mt-3 md:mt-0 text-right">
      <p class="text-yellow-300 font-semibold">👤 <%= user.ho_ten %></p>
      <p class="text-blue-300 text-xs"><%= user.email %></p>
      <a href="/logout" class="text-red-300 hover:text-red-100 text-sm underline">Đăng xuất</a>
    </div>
    <% } %>
  </div>
</header>

<% if (user) { %>
<nav class="bg-white shadow-sm sticky top-0 z-50">
  <div class="container mx-auto px-4">
    <ul class="flex space-x-1 py-3 overflow-x-auto">
      <li><a href="/books"          class="px-4 py-2 rounded-md font-medium text-gray-600 hover:bg-blue-50 hover:text-blue-700 transition whitespace-nowrap">📖 Sách</a></li>
      <li><a href="/books/create"   class="px-4 py-2 rounded-md font-medium text-gray-600 hover:bg-green-50 hover:text-green-700 transition whitespace-nowrap">➕ Thêm sách</a></li>
      <li><a href="/borrows"        class="px-4 py-2 rounded-md font-medium text-gray-600 hover:bg-blue-50 hover:text-blue-700 transition whitespace-nowrap">📋 Mượn/Trả</a></li>
      <li><a href="/borrows/create" class="px-4 py-2 rounded-md font-medium text-gray-600 hover:bg-green-50 hover:text-green-700 transition whitespace-nowrap">➕ Tạo phiếu</a></li>
      <li><a href="/stats"          class="px-4 py-2 rounded-md font-medium text-gray-600 hover:bg-purple-50 hover:text-purple-700 transition whitespace-nowrap">📊 Thống kê</a></li>
    </ul>
  </div>
</nav>
<% } %>

<main class="flex-grow container mx-auto px-4 py-8">