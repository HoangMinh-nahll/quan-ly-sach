<%- include('../partials/header') %>
<div class="space-y-6">
  <h2 class="text-2xl font-bold text-blue-900">📊 Thống kê hệ thống</h2>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
    <div class="bg-blue-600 text-white rounded-2xl p-5 text-center shadow-md">
      <p class="text-4xl font-bold"><%= stats.tongSach || 0 %></p>
      <p class="text-sm mt-2 text-blue-200">Loại sách</p>
    </div>
    <div class="bg-indigo-600 text-white rounded-2xl p-5 text-center shadow-md">
      <p class="text-4xl font-bold"><%= stats.tongBan || 0 %></p>
      <p class="text-sm mt-2 text-indigo-200">Tổng bản</p>
    </div>
    <div class="bg-yellow-500 text-white rounded-2xl p-5 text-center shadow-md">
      <p class="text-4xl font-bold"><%= stats.dangMuon || 0 %></p>
      <p class="text-sm mt-2 text-yellow-100">Đang mượn</p>
    </div>
    <div class="bg-green-600 text-white rounded-2xl p-5 text-center shadow-md">
      <p class="text-4xl font-bold"><%= stats.daTra || 0 %></p>
      <p class="text-sm mt-2 text-green-200">Đã trả</p>
    </div>
    <div class="bg-red-600 text-white rounded-2xl p-5 text-center shadow-md">
      <p class="text-4xl font-bold"><%= stats.lamMat || 0 %></p>
      <p class="text-sm mt-2 text-red-200">Làm mất</p>
    </div>
    <div class="bg-orange-500 text-white rounded-2xl p-5 text-center shadow-md">
      <p class="text-lg font-bold leading-tight"><%= Number(stats.tongPhat || 0).toLocaleString('vi-VN') %>đ</p>
      <p class="text-sm mt-2 text-orange-100">Tổng phạt</p>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-6">
    <div class="bg-white rounded-2xl shadow-md p-6">
      <h3 class="text-lg font-bold text-gray-800 mb-4">📚 Sách theo thể loại</h3>
      <% if (!stats.theoLoai || stats.theoLoai.length === 0) { %>
        <p class="text-gray-400 text-center py-8">Chưa có dữ liệu</p>
      <% } else { %>
        <div class="space-y-3">
          <% stats.theoLoai.forEach(c => { %>
          <div class="flex items-center justify-between py-2 border-b border-gray-100 last:border-0">
            <span class="text-gray-700 font-medium"><%= c.the_loai || 'Chưa phân loại' %></span>
            <span class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full text-sm font-bold"><%= c.count %> cuốn</span>
          </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="bg-white rounded-2xl shadow-md p-6">
      <h3 class="text-lg font-bold text-gray-800 mb-4">🏆 Top 5 sách mượn nhiều nhất</h3>
      <% if (!stats.topSach || stats.topSach.length === 0) { %>
        <p class="text-gray-400 text-center py-8">Chưa có dữ liệu</p>
      <% } else { %>
        <div class="space-y-3">
          <% stats.topSach.forEach((s, i) => { %>
          <div class="flex items-center gap-3 py-2 border-b border-gray-100 last:border-0">
            <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0
              <%= i===0?'bg-yellow-400 text-white':i===1?'bg-gray-300 text-gray-700':i===2?'bg-orange-400 text-white':'bg-blue-100 text-blue-700' %>">
              <%= i + 1 %>
            </div>
            <div class="flex-grow min-w-0">
              <p class="font-medium text-gray-800 truncate"><%= s.ten_sach %></p>
              <p class="text-xs text-gray-400"><%= s.tac_gia %></p>
            </div>
            <span class="text-gray-500 text-sm flex-shrink-0"><%= s.so_lan %> lần</span>
          </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>