<!DOCTYPE html>
<html>
<head>
  <title>Quản lý người dùng</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">QLS</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/books">Sách</a>
        <a class="nav-link" href="/borrows">Mượn trả</a>
        <a class="nav-link" href="/stats">Thống kê</a>
        <% if (user && user.role === 'admin') { %>
          <a class="nav-link active" href="/users">Người dùng</a>
        <% } %>
        <a class="nav-link" href="/reset-password">Đổi mật khẩu</a>
        <a class="nav-link" href="/logout">Đăng xuất</a>
      </div>
    </div>
  </nav>
  
  <div class="container mt-4">
    <div class="d-flex justify-content-between">
      <h2>Quản lý người dùng</h2>
      <a href="/users/create" class="btn btn-primary">+ Thêm người dùng</a>
    </div>
    
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    
    <table class="table table-bordered mt-3">
      <thead>
        <tr>
          <th>ID</th>
          <th>Họ tên</th>
          <th>Email</th>
          <th>Vai trò</th>
          <th>Ngày tạo</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td><%= user.id %></td>
            <td><%= user.ho_ten %></td>
            <td><%= user.email %></td>
            <td><%= user.role %></td>
            <td><%= user.created_at %></td>
            <td>
              <a href="/users/<%= user.id %>/edit" class="btn btn-sm btn-warning">Sửa</a>
              <form action="/users/<%= user.id %>/delete" method="POST" style="display:inline">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Xóa người dùng này?')">Xóa</button>
              </form>
             </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>