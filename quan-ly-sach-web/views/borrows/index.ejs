<%- include('../partials/header') %>
<div class="bg-white rounded-2xl shadow-md p-6">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-bold text-blue-900">📋 Quản lý mượn/trả sách</h2>
    <a href="/borrows/create" class="bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded-lg text-sm font-medium transition">➕ Tạo phiếu mượn</a>
  </div>
  <% if (borrows.length === 0) { %>
    <div class="text-center py-16 text-gray-400"><div class="text-6xl mb-4">📭</div><p>Chưa có phiếu mượn nào</p></div>
  <% } else { %>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead><tr class="bg-blue-50 text-blue-900">
        <th class="px-3 py-3 text-left">STT</th>
        <th class="px-3 py-3 text-left">Người mượn</th>
        <th class="px-3 py-3 text-left">Tên sách</th>
        <th class="px-3 py-3 text-center">Ngày mượn</th>
        <th class="px-3 py-3 text-center">Hạn trả</th>
        <th class="px-3 py-3 text-center">Ngày trả</th>
        <th class="px-3 py-3 text-center">Trạng thái</th>
        <th class="px-3 py-3 text-right">Tiền phạt</th>
        <th class="px-3 py-3 text-center">Thao tác</th>
      </tr></thead>
      <tbody>
        <% borrows.forEach((b, i) => { %>
        <tr class="border-t border-gray-100 hover:bg-gray-50 transition">
          <td class="px-3 py-3 text-gray-500"><%= i + 1 %></td>
          <td class="px-3 py-3"><p class="font-medium"><%= b.ho_ten %></p><p class="text-xs text-gray-400"><%= b.email %></p></td>
          <td class="px-3 py-3 font-medium text-gray-700"><%= b.ten_sach %></td>
          <td class="px-3 py-3 text-center text-gray-600"><%= new Date(b.ngay_muon).toLocaleDateString('vi-VN') %></td>
          <td class="px-3 py-3 text-center <% if(b.trang_thai==='dang_muon' && new Date()>new Date(b.ngay_hen_tra)){%>text-red-600 font-bold<%}else{%>text-gray-600<%}%>">
            <%= new Date(b.ngay_hen_tra).toLocaleDateString('vi-VN') %>
          </td>
          <td class="px-3 py-3 text-center text-gray-500"><%= b.ngay_tra ? new Date(b.ngay_tra).toLocaleDateString('vi-VN') : '—' %></td>
          <td class="px-3 py-3 text-center">
            <% if (b.trang_thai === 'dang_muon') { %>
              <span class="bg-blue-100 text-blue-700 px-2 py-1 rounded-full text-xs font-bold">📤 Đang mượn</span>
            <% } else if (b.trang_thai === 'da_tra') { %>
              <span class="bg-green-100 text-green-700 px-2 py-1 rounded-full text-xs font-bold">✅ Đã trả</span>
            <% } else { %>
              <span class="bg-red-100 text-red-700 px-2 py-1 rounded-full text-xs font-bold">❌ Làm mất</span>
            <% } %>
          </td>
          <td class="px-3 py-3 text-right font-medium">
            <% if (b.tien_phat > 0) { %><span class="text-red-600"><%= Number(b.tien_phat).toLocaleString('vi-VN') %>đ</span>
            <% } else { %><span class="text-gray-400">—</span><% } %>
          </td>
          <td class="px-3 py-3">
            <% if (b.trang_thai === 'dang_muon') { %>
            <div class="flex gap-1 justify-center">
              <form method="POST" action="/borrows/<%= b.id %>/return">
                <button class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded-lg text-xs font-medium transition">✅ Trả</button>
              </form>
              <form method="POST" action="/borrows/<%= b.id %>/lost" onsubmit="return confirm('Xác nhận mất sách? Phạt 200,000đ')">
                <button class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-lg text-xs font-medium transition">❌ Mất</button>
              </form>
            </div>
            <% } else { %><span class="text-gray-300 text-xs text-center block">—</span><% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="mt-4 p-3 bg-yellow-50 border border-yellow-200 rounded-lg text-sm text-yellow-800">
    💡 <strong>Quy định:</strong> Trả muộn <strong>5,000đ/ngày</strong> &nbsp;|&nbsp; Làm mất <strong>200,000đ</strong>
  </div>
  <% } %>
</div>
<%- include('../partials/footer') %>