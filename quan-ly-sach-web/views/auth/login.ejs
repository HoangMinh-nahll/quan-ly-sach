<%- include('../partials/header') %>
<div class="max-w-md mx-auto bg-white rounded-2xl shadow-lg p-8 mt-6">
  <div class="text-center mb-6">
    <div class="text-5xl mb-2">📚</div>
    <h2 class="text-2xl font-bold text-blue-900">Đăng nhập hệ thống</h2>
  </div>
  <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">⚠️ <%= error %></div>
  <% } %>
  <form method="POST" action="/login">
    <div class="mb-4">
      <label class="block text-gray-700 font-medium mb-2">Email</label>
      <input type="email" name="email" required placeholder="email@example.com"
        class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-400 transition">
    </div>
    <div class="mb-6">
      <label class="block text-gray-700 font-medium mb-2">Mật khẩu</label>
      <input type="password" name="mat_khau" required placeholder="••••••••"
        class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-400 transition">
    </div>
    <button type="submit" class="w-full bg-blue-700 hover:bg-blue-800 text-white font-bold py-3 rounded-lg transition">Đăng nhập</button>
  </form>
  <p class="text-center text-gray-500 mt-5 text-sm">Chưa có tài khoản? <a href="/register" class="text-blue-600 hover:underline font-medium">Đăng ký ngay</a></p>
</div>
<%- include('../partials/footer') %>